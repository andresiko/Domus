; PLANTILLA. Copia este fichero como ota_secrets.ini y rellena los dos valores.
; ota_secrets.ini NO se sube a git; esta plantilla sí.
; La contraseña debe coincidir con OTA_PASSWORD de include/secrets.h
; Uso:  pio run -e crowpanel_21_ota -t upload
[env:crowpanel_21_ota]
extends = env:crowpanel_21
upload_protocol = espota
upload_port = 192.168.1.XXX
upload_flags = --auth=cambiame
