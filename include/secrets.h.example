// Contrasena de la actualizacion por WiFi (OTA) del panel.
// Tiene que coincidir con la de ota_secrets.ini, que usa PlatformIO al subir.
#define OTA_PASSWORD  "cambiame"

// Coordenadas de casa para la prevision del tiempo (open-meteo).
// Se pueden sacar de Google Maps: clic derecho sobre el portal -> copiar.
#define WX_LATITUDE   "0.0000000"
#define WX_LONGITUDE  "0.0000000"
